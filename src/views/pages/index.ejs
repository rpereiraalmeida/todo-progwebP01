<!DOCTYPE html>
<html lang="en">

<%- include('../includes/head.ejs') %>

    <body>
        <%- include('../includes/header.ejs'); %>
            <div class="container">
                <%- include('../includes/sidebar.ejs'); %>
                    <main class="main">
                        <div class="tasks-container">
                            <div>
                                <h4>Tarefas Pendentes</h4>
                                <span class="text-help">Visualize todas as tasks que ainda não foram concluídas</span>
                                <div class="tasks-item">
                                    <div class="">
                                        <svg height="30" width="30">
                                            <circle cx="15" cy="15" r="10" fill="transparent" stroke="black"
                                                stroke-width="2" />
                                        </svg>
                                        <p>Uma task importante ai</p>
                                    </div>
                                    <div>
                                        <img src="./assets/Edit.svg" alt="" onclick="toggleFormEdit()">
                                        <img src="./assets/Remove.svg" alt="" onclick="deleteTaskItem(this)">
                                    </div>
                                </div>
                            </div>
                            <div>
                                <h4>Concluidas Recentemente</h4>
                                <span class="text-help">Suas ultimas 5 tarefas concluidas</span>
                                <div class="tasks-item">
                                    <div class="">
                                        <img src="./assets/Ok.svg" alt="">
                                        <p>Uma task importante ai</p>
                                    </div>
                                    <div>
                                        <img src="./assets/Edit.svg" alt="" onclick="toggleFormEdit()">
                                        <img src="./assets/Remove.svg" alt="" onclick="deleteTaskItem(this)">
                                    </div>
                                </div>
                            </div>
                    </main>
                    <%- include('../includes/edit-form.ejs'); %>
            </div>
            <script src="./js/ui.js"></script>
    </body>

</html>