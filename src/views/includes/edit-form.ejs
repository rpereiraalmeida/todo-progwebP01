<aside class="edit-form close-edit-form">
    <img src="./assets/Delete.svg" style="margin-left:auto;" onclick="toggleFormEdit()">
    <h4>Título</h4>
    <input type="text" class="edit-form-text mb-2">
    <h4>Descrição</h4>
    <textarea class="edit-form-textarea mb-2"></textarea>
    <h4>Lista Pertencente(opcional)</h4>
    <p class="text-help">Ao selecionar uma lista, a task será exibida associada a ela</p>
    <select name="select" class="edit-form-selector mb-2">
        <option value="Lista1">Lista 1</option>
        <option value="Lista2">Lista 2</option>
    </select>
    <h4>Data Limite</h4>
    <input type="date" class="edit-form-date mb-2">
    <button type="button" class="btn-salvar-alteracoes" onclick="fecharmenu()">Salvar alterações </button>
</aside>