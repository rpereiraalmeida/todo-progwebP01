<aside class="edit-form close-edit-form">
     <!-- Padronizado -->
    <form id="edit-form" action="/lists/update" method="POST">
        <img src="./assets/Delete.svg" style="margin-left:auto; cursor: pointer;" onclick="toggleListFormEdit()">
        <h4>Título</h4>
        <input type="text" name="title" class="edit-form-text mb-2">
        <h4>Descrição</h4>
        <textarea class="edit-form-textarea mb-2" name="description" form="taskform" rows="7" cols="45"></textarea>
        <h4>Task da Lista</h4>
        <p class="text-help">As tasks criadas dever ser inseridas na lista através da opção &quot;Lista
            Pertencente
            (Opcional)&quot; no painel de edição da task.
        </p>
        <div class="tasks-item">
            <div class="">
                <svg height="30" width="30">
                    <circle cx="15" cy="15" r="10" fill="transparent" stroke="black" stroke-width="2" />
                </svg>
                <p>Uma Lista bem legal</p>
            </div>
            <div>
                <img src="./assets/Edit.svg" alt="">
                <img src="./assets/Remove.svg" alt="">
            </div>
        </div>
        <input type="hidden" name="id" class="">
        <button type="submit" class="btn-salvar-alteracoes">Salvar alterações</button>
    </form>
</aside>